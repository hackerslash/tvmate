<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#07080B">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:layout_gravity="top|end"
        android:focusable="false"
        app:surface_type="texture_view"
        app:use_controller="false"
        app:shutter_background_color="#07080B" />

    <FrameLayout
        android:id="@+id/banner"
        android:layout_width="match_parent" android:layout_height="230dp"
        android:layout_gravity="bottom"
        android:background="@drawable/grad_bottom"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="112dp" android:layout_height="wrap_content"
            android:layout_gravity="bottom" android:layout_marginStart="50dp" android:layout_marginBottom="30dp"
            android:gravity="center_horizontal" android:orientation="vertical">
            <ImageView android:layout_width="32dp" android:layout_height="16dp" android:src="@drawable/chevron_up" />
            <FrameLayout android:layout_width="112dp" android:layout_height="63dp" android:layout_marginTop="8dp" android:background="@drawable/card">
                <TextView android:id="@+id/bLogoText" style="@style/LogoText" android:textSize="12sp" />
                <ImageView android:id="@+id/bLogo"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:padding="4dp" android:scaleType="fitCenter" />
            </FrameLayout>
            <TextView android:id="@+id/bNum"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                android:textColor="#B3FFFFFF" android:textSize="17sp" android:textStyle="bold" />
            <ImageView android:layout_width="32dp" android:layout_height="16dp" android:layout_marginTop="4dp" android:src="@drawable/chevron_down" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_gravity="bottom" android:layout_marginStart="192dp" android:layout_marginEnd="60dp" android:layout_marginBottom="44dp"
            android:orientation="vertical">
            <TextView android:id="@+id/bName"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:singleLine="true" android:textColor="#B3FFFFFF" android:textSize="14sp" />
            <TextView android:id="@+id/bTitle"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:ellipsize="end" android:singleLine="true" android:textColor="#FFFFFF" android:textSize="30sp" android:textStyle="bold" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/bTime"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="#FFFFFF" android:textSize="16sp" />
                <ProgressBar android:id="@+id/bProg" style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="96dp" android:layout_height="4dp" android:layout_marginStart="10dp"
                    android:max="1000" android:progressDrawable="@drawable/prog" />
            </LinearLayout>
            <TextView android:id="@+id/bDesc"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:ellipsize="end" android:maxLines="2" android:textColor="#B3FFFFFF" android:textSize="15sp" />
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/hint"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="top|end" android:layout_marginTop="28dp" android:layout_marginEnd="44dp"
        android:shadowColor="#CC000000" android:shadowRadius="6"
        android:text="Press LEFT ◀ to open the channel list"
        android:textColor="#FFFFFF" android:textSize="18sp" android:visibility="gone" />

    <FrameLayout
        android:id="@+id/guide"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:visibility="gone">

        <View
            android:layout_width="120dp" android:layout_height="180dp"
            android:layout_gravity="top|end" android:layout_marginEnd="250dp"
            android:background="@drawable/grad_left" />

        <LinearLayout
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="60dp" android:layout_marginTop="70dp" android:orientation="horizontal">
            <FrameLayout android:layout_width="100dp" android:layout_height="130dp" android:background="@drawable/card">
                <TextView android:id="@+id/gLogoText" style="@style/LogoText" android:textSize="15sp" />
                <ImageView android:id="@+id/gLogo"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:padding="8dp" android:scaleType="fitCenter" />
            </FrameLayout>
            <LinearLayout android:layout_width="360dp" android:layout_height="wrap_content"
                android:layout_marginStart="20dp" android:orientation="vertical">
                <TextView android:id="@+id/gTitle"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:ellipsize="end" android:maxLines="2" android:textColor="#FFFFFF" android:textSize="24sp" android:textStyle="bold" />
                <TextView android:id="@+id/gTime"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp"
                    android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" />
                <TextView android:id="@+id/gDesc"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                    android:ellipsize="end" android:maxLines="3" android:textColor="#B3FFFFFF" android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rail"
            android:layout_width="210dp" android:layout_height="match_parent"
            android:layout_marginStart="44dp" android:layout_marginTop="262dp"
            android:clipToPadding="false" android:paddingBottom="40dp" />

        <TextView android:id="@+id/gCat"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="289dp" android:layout_marginTop="262dp"
            android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" />

        <LinearLayout android:id="@+id/searchBar"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="289dp" android:layout_marginTop="232dp" android:layout_marginEnd="60dp"
            android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
            <EditText android:id="@+id/gSearch"
                android:layout_width="460dp" android:layout_height="44dp"
                android:background="@drawable/input" android:drawablePadding="10dp"
                android:hint="⌕  Channel name, e.g. sky sports"
                android:imeOptions="actionSearch|flagNoExtractUi" android:inputType="text"
                android:paddingHorizontal="16dp" android:singleLine="true"
                android:textColor="#FFFFFF" android:textColorHint="#66FFFFFF" android:textSize="16sp" />
            <TextView android:id="@+id/gSearchCount"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp"
                android:textColor="#99FFFFFF" android:textSize="14sp" />
        </LinearLayout>

        <TextView android:id="@+id/gEmpty"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="289dp" android:layout_marginTop="320dp"
            android:textColor="#80FFFFFF" android:textSize="16sp" android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rows"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:layout_marginStart="289dp" android:layout_marginTop="288dp"
            android:clipToPadding="false" android:paddingBottom="120dp" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/updateCard"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal" android:layout_marginTop="24dp"
        android:background="@drawable/overlay_card" android:gravity="center_vertical"
        android:orientation="horizontal" android:paddingStart="18dp" android:paddingTop="16dp"
        android:paddingEnd="28dp" android:paddingBottom="16dp" android:visibility="gone">
        <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@mipmap/ic_launcher" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="16dp" android:orientation="vertical">
            <TextView android:id="@+id/upTitle"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" />
            <TextView android:id="@+id/upSub"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"
                android:textColor="#B3FFFFFF" android:textSize="14sp" />
            <ProgressBar android:id="@+id/upProg" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="280dp" android:layout_height="4dp" android:layout_marginTop="10dp"
                android:max="100" android:progressDrawable="@drawable/prog" android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/tour"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="#D9000000" android:clickable="true" android:visibility="gone">
        <LinearLayout
            android:layout_width="600dp" android:layout_height="wrap_content" android:layout_gravity="center"
            android:background="@drawable/overlay_card" android:gravity="center_horizontal"
            android:orientation="vertical" android:padding="40dp">
            <TextView android:id="@+id/tourStep"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:letterSpacing="0.12" android:textAllCaps="true"
                android:textColor="#80FFFFFF" android:textSize="12sp" android:textStyle="bold" />
            <FrameLayout android:layout_width="match_parent" android:layout_height="180dp" android:layout_marginTop="20dp">
                <ImageView android:id="@+id/tourLogo"
                    android:layout_width="320dp" android:layout_height="132dp" android:layout_gravity="center"
                    android:scaleType="fitCenter" android:src="@drawable/wordmark" />
                <FrameLayout android:id="@+id/dpad"
                    android:layout_width="180dp" android:layout_height="180dp" android:layout_gravity="center"
                    android:background="@drawable/dpad_ring">
                    <ImageView android:id="@+id/dUp" android:layout_width="40dp" android:layout_height="20dp"
                        android:layout_gravity="top|center_horizontal" android:layout_marginTop="22dp" android:src="@drawable/chevron_up" />
                    <ImageView android:id="@+id/dDown" android:layout_width="40dp" android:layout_height="20dp"
                        android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="22dp" android:src="@drawable/chevron_down" />
                    <ImageView android:id="@+id/dLeft" android:layout_width="40dp" android:layout_height="20dp"
                        android:layout_gravity="start|center_vertical" android:layout_marginStart="8dp"
                        android:rotation="-90" android:src="@drawable/chevron_up" />
                    <ImageView android:id="@+id/dRight" android:layout_width="40dp" android:layout_height="20dp"
                        android:layout_gravity="end|center_vertical" android:layout_marginEnd="8dp"
                        android:rotation="90" android:src="@drawable/chevron_up" />
                    <TextView android:id="@+id/dOk" android:layout_width="64dp" android:layout_height="64dp"
                        android:layout_gravity="center" android:background="@drawable/dpad_ok" android:gravity="center"
                        android:text="OK" android:textColor="#07080B" android:textSize="16sp" android:textStyle="bold" />
                </FrameLayout>
                <TextView android:id="@+id/keycap"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center"
                    android:background="@drawable/keycap" android:paddingStart="32dp" android:paddingTop="18dp"
                    android:paddingEnd="32dp" android:paddingBottom="18dp"
                    android:textColor="#FFFFFF" android:textSize="26sp" android:textStyle="bold" />
            </FrameLayout>
            <TextView android:id="@+id/tourTitle"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp"
                android:gravity="center" android:textColor="#FFFFFF" android:textSize="28sp" android:textStyle="bold" />
            <TextView android:id="@+id/tourBody"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp"
                android:gravity="center" android:lineSpacingMultiplier="1.15" android:textColor="#B3FFFFFF" android:textSize="17sp" />
            <LinearLayout android:id="@+id/tourDots"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="28dp"
                android:orientation="horizontal" />
            <TextView android:id="@+id/tourHint"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp"
                android:textColor="#80FFFFFF" android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center" android:gravity="center"
        android:shadowColor="#CC000000" android:shadowRadius="6"
        android:textColor="#FFFFFF" android:textSize="18sp" android:visibility="gone" />
</FrameLayout>
