<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content" android:layout_height="76dp"
    android:layout_marginBottom="6dp" android:focusable="true" android:orientation="horizontal">

    <FrameLayout android:layout_width="100dp" android:layout_height="match_parent" android:background="@drawable/card">
        <TextView android:id="@+id/logoText" style="@style/LogoText" android:textSize="13sp" />
        <ImageView android:id="@+id/logo"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:padding="8dp" android:scaleType="fitCenter" />
    </FrameLayout>

    <LinearLayout android:id="@+id/now"
        android:layout_width="254dp" android:layout_height="match_parent" android:layout_marginStart="3dp"
        android:background="@drawable/card_now" android:duplicateParentState="true"
        android:orientation="vertical" android:padding="10dp">
        <TextView android:id="@+id/nowTitle"
            android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:ellipsize="end" android:singleLine="true" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/nowLeft"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:ellipsize="end" android:maxWidth="230dp" android:singleLine="true"
                android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" />
            <ProgressBar android:id="@+id/nowProg" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="110dp" android:layout_height="3dp" android:layout_marginStart="8dp"
                android:max="1000" android:progressDrawable="@drawable/prog" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:id="@+id/next1"
        android:layout_width="254dp" android:layout_height="match_parent" android:layout_marginStart="3dp"
        android:background="@drawable/card" android:orientation="vertical" android:padding="10dp">
        <TextView android:id="@+id/next1Title"
            android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:ellipsize="end" android:singleLine="true" android:textColor="#CCFFFFFF" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/next1Time"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#80FFFFFF" android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout android:id="@+id/next2"
        android:layout_width="254dp" android:layout_height="match_parent" android:layout_marginStart="3dp"
        android:background="@drawable/card" android:orientation="vertical" android:padding="10dp">
        <TextView android:id="@+id/next2Title"
            android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:ellipsize="end" android:singleLine="true" android:textColor="#CCFFFFFF" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/next2Time"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#80FFFFFF" android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
